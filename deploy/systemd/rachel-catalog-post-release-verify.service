[Unit]
Description=Verify Rachel Catalog public deployment after release
After=network-online.target rachel-catalog.service
Wants=network-online.target

[Service]
Type=oneshot
User=rachelcode
Group=rachelcode
WorkingDirectory=/opt/rachelcode/app
Environment=CATALOG_DEPLOYMENT_CHECK_COUNT=256
Environment=CATALOG_EXPECTED_WORKERS=8
Environment=CATALOG_POST_RELEASE_STATE=/data/rachelcode/catalog/post-release-verification.json
ExecStart=/opt/rachelcode/app/scripts/run_post_release_verification.sh http://203.205.90.232:8765
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=900
UMask=0027
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/data/rachelcode/catalog
