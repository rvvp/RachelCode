[Unit]
Description=Rachel Catalog Web Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rachelcode
Group=rachelcode
WorkingDirectory=/opt/rachelcode/app
Environment=PYTHONUNBUFFERED=1
Environment=CATALOG_BRAND_MARK=Sienna
ExecStart=/opt/rachelcode/venv/bin/python /opt/rachelcode/app/app.py --host 0.0.0.0 --port 8765 --db /data/rachelcode/catalog/catalog.db --uploads /data/rachelcode/catalog/uploads --no-seed-demo --no-seed-samples
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/data/rachelcode

[Install]
WantedBy=multi-user.target
