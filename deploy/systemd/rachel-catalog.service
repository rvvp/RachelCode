[Unit]
Description=Rachel Catalog Web Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rachelcode
Group=rachelcode
WorkingDirectory=/opt/rachelcode/app
Environment=PYTHONUNBUFFERED=1
Environment=CATALOG_BRAND_MARK=Sienna
Environment=CATALOG_DB=/data/rachelcode/catalog/catalog.db
Environment=CATALOG_UPLOADS=/data/rachelcode/catalog/uploads
Environment=CATALOG_SEED_DEMO=0
Environment=CATALOG_SEED_SAMPLES=0
Environment=CATALOG_RUNTIME_MODE=production
Environment=CATALOG_IMPORT_SLOTS=2
Environment=CATALOG_IMPORT_WRITE_SLOTS=1
Environment=CATALOG_IMPORT_TASK_WAIT_SECONDS=120
Environment=CATALOG_EXPORT_SLOTS=4
Environment=CATALOG_IMAGE_EXPORT_SLOTS=2
Environment=CATALOG_HEAVY_TASK_WAIT_SECONDS=900
Environment=CATALOG_POST_RELEASE_STATE=/data/rachelcode/catalog/post-release-verification.json
ExecStart=/opt/rachelcode/venv/bin/gunicorn --chdir /opt/rachelcode/app --bind 0.0.0.0:8765 --workers 8 --threads 4 --worker-class gthread --timeout 1800 --graceful-timeout 30 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --worker-tmp-dir /dev/shm catalog_wsgi:application
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/data/rachelcode

[Install]
WantedBy=multi-user.target
