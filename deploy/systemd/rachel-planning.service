[Unit]
Description=Rachel Merchandise Planning Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rachelcode
Group=rachelcode
WorkingDirectory=/opt/rachelcode/planning/current
Environment=PYTHONUNBUFFERED=1
Environment=PLANNING_CATALOG_API_URL=http://127.0.0.1:8765
EnvironmentFile=/etc/rachelcode/planning.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rachelcode/planning/venv/bin/python /opt/rachelcode/planning/current/planning_app.py --host 0.0.0.0 --port 8785 --db /data/rachelcode/planning/planning.db --no-seed-demo
Restart=on-failure
RestartSec=3
TimeoutStopSec=130
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/rachelcode/planning

[Install]
WantedBy=multi-user.target
