[Unit]
Description=Rachel Replenishment Web Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rachelcode
Group=rachelcode
WorkingDirectory=/opt/rachelcode/replenishment/current
EnvironmentFile=/etc/rachelcode/replenishment.env
Environment=PYTHONUNBUFFERED=1
Environment=REPLENISH_PUBLIC_BASE_URL=https://sienna.tiger8.com.cn
Environment=REPLENISH_RUNTIME_MODE=production
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rachelcode/replenishment/venv/bin/python /opt/rachelcode/replenishment/current/replenishment_app.py --host 0.0.0.0 --port 8877 --db /data/rachelcode/replenishment/replenishment.db --no-seed-demo --scheduler
Restart=on-failure
RestartSec=3
TimeoutStopSec=130
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/rachelcode/replenishment

[Install]
WantedBy=multi-user.target
