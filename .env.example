CATALOG_HOST=0.0.0.0
CATALOG_PORT=8765
CATALOG_DB=/Users/apple/Documents/商品资料后台/data/catalog.db
CATALOG_UPLOADS=/Users/apple/Documents/商品资料后台/data/uploads
CATALOG_BACKUP_KEEP=14
CATALOG_BACKUP_HOUR=2
CATALOG_BACKUP_MINUTE=30

# 演示环境可设为 1，正式环境建议设为 0
CATALOG_SEED_DEMO=0
CATALOG_SEED_SAMPLES=0

# 首次初始化正式管理员
CATALOG_BOOTSTRAP_ADMIN_USERNAME=owner_admin
CATALOG_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123
CATALOG_BOOTSTRAP_ADMIN_NAME=系统管理员
CATALOG_BOOTSTRAP_ADMIN_FORCE_RESET=1

# 交付品牌化配置
CATALOG_BRAND_NAME=思安娜的\n藏寶閣
CATALOG_BRAND_MARK=Sienna
CATALOG_BRAND_TAGLINE=让商品资料从分散表格进入统一底库
CATALOG_BRAND_SUBTITLE=面向跟单部、商品部与运营部协作的内部资料后台，支持跟单部主体填写、商品部补充品类、图片、上新价格、上新渠道和资料完成，运营部只读开放与结构化调用。
CATALOG_BRAND_EYEBROW=Sienna Treasure Pavilion
CATALOG_CONSOLE_EYEBROW=Sienna Treasure Workspace
CATALOG_BRAND_ACCENT=#bc6c25
CATALOG_BRAND_ACCENT_STRONG=#7f3b08
CATALOG_BRAND_ACCENT_DEEP=#355f52

# 商品企划中心与藏宝阁的内部 API（正式环境请使用随机长 Token）
CATALOG_PLANNING_API_TOKEN=replace-with-a-long-random-token
PLANNING_CATALOG_API_URL=http://127.0.0.1:8765
PLANNING_CATALOG_API_TOKEN=replace-with-the-same-long-random-token
PLANNING_HOST=0.0.0.0
PLANNING_PORT=8785
PLANNING_DB=/Users/apple/Documents/商品资料后台/planning_data/planning.db
PLANNING_SEED_DEMO=0
PLANNING_BOOTSTRAP_ADMIN_USERNAME=planning_owner
PLANNING_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123
PLANNING_BOOTSTRAP_ADMIN_NAME=企划管理员
